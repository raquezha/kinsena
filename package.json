{
	"name": "kinsena",
	"version": "0.4.1",
	"description": "A self-hosted payday routing checklist for bills, statements, and transfers.",
	"license": "MIT",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.17"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node server.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "vite build && playwright test --project=mobile --project=tablet --project=desktop --project=activity-e2e",
		"screenshots": "vite build && playwright test --project=screenshots --project=activity-e2e",
		"icons": "sh scripts/generate-icons.sh",
		"db:generate": "drizzle-kit generate"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"better-sqlite3": "^13.2.0",
		"drizzle-orm": "^0.45.4",
		"simple-icons": "^16.38.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-node": "^6.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^22.20.5",
		"@vitest/coverage-v8": "^5.1.0",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"lucide-static": "^1.73.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-dnd-action": "^0.9.80",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	}
}
